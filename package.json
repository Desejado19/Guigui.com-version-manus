{
  "name": "guigui",
  "description": "Plataforma comercial, cultural e de bilhética da Guiné-Bissau",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev.pinned": "cross-env NODE_ENV=development PORT=3000 node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "verify:deploy": "node scripts/verify-production-surface.mjs",
    "prestart": "npm run db:migrate",
    "start": "node scripts/start-production.mjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test:follow": "tsx scripts/audit-follow-notifications.ts",
    "test:payments": "tsx scripts/audit-payment-flow.ts",
    "test:subscriptions": "tsx scripts/audit-subscription-flow.ts",
    "test:moderation": "tsx scripts/audit-moderation-pipeline.ts",
    "test:moderation-central": "tsx scripts/audit-central-moderation.ts",
    "test:app-state": "tsx scripts/audit-app-state-persistence.ts",
    "test:catalog": "tsx scripts/audit-subscription-catalog.ts",
    "email:check": "tsx scripts/email-check.ts",
    "test:monetization": "tsx scripts/audit-monetization-engine.ts",
    "test:spec-integrations": "tsx scripts/audit-spec-integrations.ts",
    "backup:json": "tsx scripts/export-json-snapshot.ts",
    "backup:postgres": "tsx scripts/backup-postgres.ts",
    "backup:postgres:verify": "tsx scripts/verify-postgres-backup.ts",
    "worker": "tsx scripts/worker.ts",
    "test:load": "tsx scripts/smoke-load.ts",
    "db:import-users": "tsx scripts/import-users-postgres.ts",
    "db:ensure-demo-users": "tsx scripts/ensure-demo-users.ts",
    "db:import-tickets": "tsx scripts/import-tickets-postgres.ts",
    "db:import-payments": "tsx scripts/import-payments-postgres.ts",
    "db:import-audit": "tsx scripts/import-audit-postgres.ts",
    "db:import-moderation": "tsx scripts/import-moderation-postgres.ts",
    "db:import-businesses-events": "tsx scripts/import-businesses-events-postgres.ts",
    "db:import-monetization": "tsx scripts/import-monetization-postgres.ts",
    "db:import-catalog": "tsx scripts/import-catalog-postgres.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:check": "tsx scripts/migrate-db.ts --check",
    "db:seed-demo": "tsx scripts/seed-demo-dataset.ts",
    "db:seed:synthetic": "tsx scripts/generate-postgres-synthetic-seed.ts",
    "db:seed:full": "tsx scripts/seed-full-demo.ts",
    "test:tickets": "tsx scripts/audit-ticket-validation.ts && tsx scripts/audit-ticket-flow.ts",
    "pretest:e2e": "npm run db:seed-demo",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:components": "vitest run tests/unit/components",
    "test:integration": "vitest run tests/unit/postgresServices.integration.test.ts tests/unit/ticketsSoldExport.integration.test.ts tests/unit/ticketsSoldAggregation.integration.test.ts",
    "test:responsive": "playwright test tests/responsive.spec.ts",
    "test:i18n": "tsx scripts/check-locales.ts",
    "check:locales": "tsx scripts/check-locales.ts",
    "audit:i18n": "node scripts/audit-i18n-coverage.mjs",
    "audit:colors": "node scripts/audit-colors.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/nodemailer": "^8.0.1",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "qs": "6.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.4",
    "vitest": "^5.0.1"
  }
}
