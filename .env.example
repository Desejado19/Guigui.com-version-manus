# Obrigatório. development = Vite middleware; production = ficheiros em dist/
NODE_ENV=development
# Obrigatório. Porta HTTP do Express.
PORT=3000
# Opcional. Interface de escuta do Express; use 127.0.0.1 para limitar a localhost.
HOST=0.0.0.0
# Obrigatório. URL pública usada em sitemap, convites e cookies de contexto.
APP_URL=http://127.0.0.1:3000
# Obrigatório se o frontend estiver noutro origin. Lista separada por vírgulas.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
# Opcional em desenvolvimento (default true fora de production). false em produção.
ENABLE_DEMO_ACCOUNTS=true

# Opcional. Se vazio/ausente, o runtime usa JSON em data/ (GUIGUI_DATA_DIR).
# Nunca commitar credenciais reais. Exemplo não funcional:
DATABASE_URL=postgresql://user:password@localhost:5432/guigui
# Opcional. Tamanho máximo do pool pg.
DATABASE_POOL_MAX=10
# Opcional. Pasta de JSON/sessões/uploads lógicos.
GUIGUI_DATA_DIR=data
# Opcional. Destino dos scripts backup:json e backup:postgres.
GUIGUI_BACKUP_DIR=backups

# --- Cópias de segurança (Secção 3.9.14) -------------------------------------
# OBRIGATÓRIO em produção. Sem esta chave o backup é gerado SEM CIFRAGEM e o
# painel avisa. Gere com: openssl rand -hex 32
GUIGUI_BACKUP_ENCRYPTION_KEY=
# Opcional. Horas entre cópias automáticas. 0 ou vazio = só a pedido manual.
GUIGUI_BACKUP_INTERVAL_HOURS=0
# Opcional. Directório fora desta máquina (disco externo, volume montado).
# A réplica é relida e comparada por SHA-256 antes de ser considerada boa.
GUIGUI_BACKUP_REPLICA_DIR=
# Opcional. Número de cópias conservadas. Por omissão 7.
GUIGUI_BACKUP_RETENTION=7

# --- Gateway de SMS (Secção 7 / GUI-3.4.06) -----------------------------------
# Reservado para um futuro adapter. A composição actual é apenas simulada e
# ignora estes valores; mesmo configurados, não enviam SMS reais.
GUIGUI_SMS_GATEWAY_URL=
GUIGUI_SMS_GATEWAY_KEY=
# Compatibilidade futura; não activa modo live nem envio externo nesta fase.
GUIGUI_SMS_MODE=
# Remetente reservado para um futuro adapter de SMS.
GUIGUI_SMS_SENDER=GUIGUI
# Timeout reservado para um futuro adapter de SMS, em milissegundos.
GUIGUI_SMS_TIMEOUT_MS=10000

# Obrigatório em produção. Gerar valores únicos fora do controlo de versões.
SESSION_COOKIE_SECRET=replace-with-a-long-random-secret
MFA_SECRET=replace-with-a-long-random-secret
TICKET_SIGNING_SECRET=replace-with-a-long-random-secret
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
SCANNER_DOOR_CODE=replace-with-a-private-door-code

# Opcional. Moderação Gemini. Vazio = geminiActive false.
GEMINI_API_KEY=
# Reservado para um futuro adapter. A composição actual é apenas simulada e
# ignora estas credenciais; mesmo configuradas, não enviam email real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_SECURE=false
# Opcional. Sandbox de pagamentos confirma automaticamente se não for false.
PAYMENT_SANDBOX_AUTOCONFIRM=true

# Opcional. Flags de produto.
FEATURE_PRODUCT_ANALYTICS=true
FEATURE_PUBLIC_SEO=true
FEATURE_RECOMMENDATIONS=false

# Opcional. Caminhos Windows dos binários PostgreSQL, se não estiverem no PATH.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
