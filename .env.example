# Obrigatório. development = Vite middleware; production = ficheiros em dist/
NODE_ENV=development
# Obrigatório. Porta HTTP do Express.
PORT=3000
# Opcional. Interface de escuta do Express; use 127.0.0.1 para limitar a localhost.
HOST=0.0.0.0
# Obrigatório. URL pública usada em sitemap, convites e cookies de contexto.
APP_URL=http://127.0.0.1:3000
# Opcional. Confiança no proxy para `req.ip` e X-Forwarded-For.
# Valores: false | true | número de proxies | loopback | lista de IPs/CIDRs.
# Por omissão: loopback em desenvolvimento e 1 em produção.
TRUST_PROXY=loopback
# Obrigatório se o frontend estiver noutro origin. Lista separada por vírgulas.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
# Opcional em desenvolvimento (default true fora de production). false em produção.
ENABLE_DEMO_ACCOUNTS=true

# Opcional. Se vazio/ausente, o runtime usa JSON em data/ (GUIGUI_DATA_DIR).
# Nunca commitar credenciais reais. Exemplo não funcional:
DATABASE_URL=postgresql://user:password@localhost:5432/guigui
# Opcional. Tamanho máximo do pool pg.
DATABASE_POOL_MAX=10
# Opcional. 1 activa o Row Level Security por pedido (migração 012): cada pedido
# /api corre como guigui_app com app.user_id/app.role/app.business_id. O papel
# guigui_app é criado pela migração; 0 mantém o comportamento anterior.
RLS_ENABLED=0
# Opcional. Pasta de JSON/sessões/uploads lógicos.
GUIGUI_DATA_DIR=data
# Opcional. Destino dos scripts backup:json e backup:postgres.
GUIGUI_BACKUP_DIR=backups

# --- Cópias de segurança (Secção 3.9.14) -------------------------------------
# OBRIGATÓRIO em produção. Sem esta chave o backup é gerado SEM CIFRAGEM e o
# painel avisa. Gere com: openssl rand -hex 32
GUIGUI_BACKUP_ENCRYPTION_KEY=
# Opcional. Horas entre cópias automáticas. 0 ou vazio = só a pedido manual.
GUIGUI_BACKUP_INTERVAL_HOURS=0
# Opcional. Directório fora desta máquina (disco externo, volume montado).
# A réplica é relida e comparada por SHA-256 antes de ser considerada boa.
GUIGUI_BACKUP_REPLICA_DIR=
# Opcional. Número de cópias conservadas. Por omissão 7.
GUIGUI_BACKUP_RETENTION=7

# --- Gateway de SMS (Secção 7 / GUI-3.4.06) -----------------------------------
# Reservado para um futuro adapter. A composição actual é apenas simulada e
# ignora estes valores; mesmo configurados, não enviam SMS reais.
GUIGUI_SMS_GATEWAY_URL=
GUIGUI_SMS_GATEWAY_KEY=
# Compatibilidade futura; não activa modo live nem envio externo nesta fase.
GUIGUI_SMS_MODE=
# Remetente reservado para um futuro adapter de SMS.
GUIGUI_SMS_SENDER=GUIGUI
# Timeout reservado para um futuro adapter de SMS, em milissegundos.
GUIGUI_SMS_TIMEOUT_MS=10000

# Obrigatório em produção. Gerar valores únicos fora do controlo de versões.
SESSION_COOKIE_SECRET=replace-with-a-long-random-secret
MFA_SECRET=replace-with-a-long-random-secret
TICKET_SIGNING_SECRET=replace-with-a-long-random-secret
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
SCANNER_DOOR_CODE=replace-with-a-private-door-code

# Opcional. Moderação Gemini. Vazio = geminiActive false.
GEMINI_API_KEY=

# --- Login com Google (Google OAuth 2.0 authorization code) -----------------------------
# Client ID público do OAuth client do tipo "Web application". Sem ele a UI
# mostra que o login com Google está por configurar.
VITE_GOOGLE_CLIENT_ID=
# Client ID usado pelo backend para validar a assinatura e a audiência (aud) do
# ID token. Normalmente o mesmo valor de VITE_GOOGLE_CLIENT_ID; sem ele o login
# Google é recusado em vez de aceitar tokens por verificar.
GOOGLE_CLIENT_ID=
# Client secret do mesmo OAuth client. Fica so no servidor: e usado em
# /api/auth/google/callback para trocar o codigo de autorizacao pelo ID token
# e nunca deve aparecer numa variavel VITE_*.
GOOGLE_CLIENT_SECRET=
# Opcional. URI de redireccionamento registado no cliente OAuth. Por omissao
# e derivado do pedido (<origem>/api/auth/google/callback); defina-o em
# producao atras de proxy para nao depender do protocolo/host do servidor.
# GOOGLE_REDIRECT_URI=https://guigui.com/api/auth/google/callback
# --- Email transaccional e email externo (server/email) ----------------------
# Fornecedor real: explicito em EMAIL_PROVIDER (brevo|smtp) ou inferido de
# BREVO_API_KEY / SMTP_HOST. EMAIL_PROVIDER=none desliga o envio. Sem
# fornecedor, os fluxos automaticos (convites, bilhetes) ficam em modo
# simulado e devolvem o link manual; o email escrito por uma pessoa em
# POST /api/emails/external nunca simula: responde 503 EMAIL_NOT_CONFIGURED.
EMAIL_PROVIDER=
BREVO_API_KEY=
# Remetente. Aceita "Guigui.com <no-reply@guigui.com>". Obrigatorio em
# producao; em desenvolvimento, sem ele, usa-se no-reply@guigui.local.
EMAIL_FROM=
# Opcional. Nome usado quando EMAIL_FROM traz apenas o endereco.
EMAIL_FROM_NAME=Guigui.com
# Opcional. Reply-To dos fluxos automaticos. O email externo usa sempre o
# endereco da conta que escreve, para a resposta ir para essa pessoa.
EMAIL_REPLY_TO=
# Tentativas por mensagem (1..5) e base do backoff exponencial (tecto 30s).
# Um 502 no email externo significa que o fornecedor recusou apos tentar.
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY_MS=500
# SMTP. Mailpit local: SMTP_HOST=127.0.0.1 e SMTP_PORT=1025, sem SMTP_USER.
# Uma caixa local nao envia para a Internet (ver docs/EMAIL-EXTERNO.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Opcional. Sandbox de pagamentos confirma automaticamente se não for false.
PAYMENT_SANDBOX_AUTOCONFIRM=true

# Opcional. Flags de produto.
FEATURE_PRODUCT_ANALYTICS=true
FEATURE_PUBLIC_SEO=true
FEATURE_RECOMMENDATIONS=false

# Opcional. Caminhos Windows dos binários PostgreSQL, se não estiverem no PATH.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe

# --- Pool PostgreSQL, limites e compressão -----------------------------------
# Opcional. Ligação alternativa ao pooler (PgBouncer/Neon/Supabase). Quando
# definida, os pedidos usam-na em vez de DATABASE_URL; migrações e backups
# continuam a usar DATABASE_URL (ligação directa).
# DATABASE_POOLER_URL=postgresql://user:password@host:6543/guigui
# Opcional. Limites do pool `pg` (valores por omissão entre parênteses).
# DATABASE_POOL_MIN=(0)
# DATABASE_POOL_MAX=10
# DATABASE_POOL_MAX_USES=(ilimitado)
# DATABASE_POOL_IDLE_TIMEOUT_MS=(10000)
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=(0)
# DATABASE_POOL_STATEMENT_TIMEOUT_MS=(0)
# DATABASE_POOL_LOCK_TIMEOUT_MS=(0)
# DATABASE_POOL_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=(0)
# DATABASE_POOL_HEALTH_CHECK_INTERVAL_MS=(30000)
# Opcional. TTL do cache de respostas comprimidas, em milissegundos.
# HTTP_COMPRESSION_CACHE_TTL_MS=(60000)
# Opcional. Tecto de pedidos por janela nos limitadores públicos (por omissão 120).
# RATE_LIMIT_MAX_REQUESTS=120

# --- Scripts de auditoria e de carga (não precisam de existir em produção) ---
