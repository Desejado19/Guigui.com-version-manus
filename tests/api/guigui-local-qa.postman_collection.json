{
  "info": {
    "name": "Guigui.com Local QA API",
    "description": "Read-only local API checks for public routes and anonymous authorization barriers. Uses the isolated synthetic PostgreSQL QA database only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "protocolProfileBehavior": {
    "followRedirects": false
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const name = pm.info.requestName;",
          "const status = pm.response.code;",
          "pm.test('response is not a server error', function () { pm.expect(status).to.be.below(500); });",
          "if (name.startsWith('[auth]')) {",
          "  pm.test('anonymous route access is rejected', function () { pm.expect([401, 403]).to.include(status); });",
          "} else if (name.startsWith('[not-found]')) {",
          "  pm.test('synthetic identifier is not found', function () { pm.expect(status).to.eql(404); });",
          "} else if (name.startsWith('[empty-or-not-found]')) {",
          "  pm.test('synthetic resource is empty or not found', function () { pm.expect([200, 404]).to.include(status); });",
          "} else {",
          "  pm.test('public route responds successfully', function () { pm.expect(status).to.eql(200); });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "qaBaseUrl",
      "value": "http://127.0.0.1:4313",
      "type": "string"
    },
    {
      "key": "syntheticId",
      "value": "qa-nonexistent-record",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Canonical API paths",
      "item": [
        {"name":"[auth] GET /api/admin/audit-logs","request":{"method":"GET","url":{"raw":"{{qaBaseUrl}}/api/admin/audit-logs"}}},
